# AI Code Explainer - .gitignore
# Protects secrets and generated files from being committed to Git

# ============================================================
# SECRETS — NEVER commit these
# ============================================================
backend/.env
.env
*.env

# ============================================================
# Python
# ============================================================
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
*.pyd
.Python

# Virtual environments
backend/venv/
venv/
env/
ENV/
.venv/

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg

# Testing
.pytest_cache/
.coverage
htmlcov/

# ============================================================
# IDE / Editor
# ============================================================
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ============================================================
# Node / npm (if used in future steps)
# ============================================================
node_modules/
npm-debug.log*
